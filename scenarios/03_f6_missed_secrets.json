  },
  "steps": [
    {
      "note": "Run starts",
      "elapsed": 0,
      "events": [{ "type": "run_start" }],
      "expect": { "gradeAtLeast": "S", "noWarnings": ["secrets_short"] }
    },
    {
      "note": "Four big rooms cleared quickly but most of their secrets were missed",
      "elapsed": 150,
      "events": [
        { "type": "room_clear", "roomId": "B1", "playerId": "p2", "secretsFound": 2 },

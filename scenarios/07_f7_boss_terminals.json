    {
      "note": "Goldor phase: everyone sees their own first slot",
      "elapsed": 420,
      "events": [{ "type": "boss_phase", "phase": "p3" }],
      "expect": {
        "actions": {
          "p1": { "titleIncludes": "S1 Simon Says" },
          "p2": { "titleIncludes": "Goldor terminals: S1" },
          "p5": { "titleIncludes": "Goldor terminals: S1" }
        }
      }
    },
    {
      "note": "Simon Says done: Berserk moves to their next slot",
      "elapsed": 440,
      "events": [{ "type": "terminal_set", "section": 1, "kind": "device", "done": true }],
      "expect": { "actions": { "p1": { "titleIncludes": "Goldor terminals: S1 lever" } } }
    },
    {
      "note": "Run complete",
      "elapsed": 620,
      "events": [{ "type": "run_complete", "bossKilled": true }],
      "expect": { "phase": "complete", "actions": { "p1": { "type": "complete" } } }
    }
  ]
